<?xml version="1.0" encoding="utf-8"?>
<!-- GOD MODE: MILITARY GRADE QUANTUM NETWORK SECURITY - NO SNIFFING POSSIBLE -->
<network-security-config>

    <!-- 1. GLOBAL BLACKOUT - NO CLEARTEXT ANYWHERE -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- ONLY trust system CAs, block user-installed certs (blocks Charles Proxy / MitM) -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 2. LOCAL DEV - ONLY FOR YOUR AI GATEWAY -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <!-- 3. GOD MODE PINNING - YOUR BACKEND - CHANGE THIS TO YOUR DOMAIN -->
    <!-- 
      This prevents even NSA-level MitM. If certificate doesn't match exact pin, connection dies.
      To get your pin: echo | openssl s_client -connect yourdomain.com:443 | openssl x509 -pubkey | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | openssl enc -base64
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">firestore.googleapis.com</domain>
        <domain includeSubdomains="true">firebase.googleapis.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <pin-set expiration="2030-01-01">
            <!-- Google Trust Services - Replace with your own server pins for MAX security -->
            <pin digest="SHA-256">uK9L9aDngAT+YOlf8KJtIfdokWitnFxoEVxM+ZOzyfM=</pin>
            <pin digest="SHA-256">YPtHaftLw6/0vnc2BnNKGF54xiCA28WFcccjkA4ypCM=</pin>
            <pin digest="SHA-256">hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- 4. DEBUG OVERRIDE - Allows Charles/Proxy ONLY in debug build, never in release -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

</network-security-config>