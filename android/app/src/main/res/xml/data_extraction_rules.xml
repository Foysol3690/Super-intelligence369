<?xml version="1.0" encoding="utf-8"?>
<!-- GOD MODE: ULTRA FUTURISTIC FULLY LOADED MAXOUT - NO DATA EXTRACTION ALLOWED -->
<data-extraction-rules>
    <!-- 1. GOOGLE CLOUD BACKUP - TOTAL BLACKOUT -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- Exclude entire domains - The "." means EVERYTHING inside -->
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        
        <!-- Futuristic explicit path wildcards for max compatibility -->
        <exclude domain="file" path="files/" />
        <exclude domain="file" path="cache/" />
        <exclude domain="file" path="code_cache/" />
        <exclude domain="file" path="no_backup/" />
        <exclude domain="root" path="no_backup/" />
        <exclude domain="root" path="files/" />
        <exclude domain="root" path="databases/" />
        <exclude domain="root" path="shared_prefs/" />
        <exclude domain="root" path="cache/" />
    </cloud-backup>

    <!-- 2. DEVICE TO DEVICE TRANSFER (Smart Switch, etc) - TOTAL BLACKOUT -->
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        
        <exclude domain="file" path="files/" />
        <exclude domain="file" path="cache/" />
        <exclude domain="file" path="code_cache/" />
        <exclude domain="file" path="no_backup/" />
        <exclude domain="root" path="no_backup/" />
        <exclude domain="root" path="files/" />
        <exclude domain="root" path="databases/" />
        <exclude domain="root" path="shared_prefs/" />
        <exclude domain="root" path="cache/" />
    </device-transfer>
</data-extraction-rules>